# Ollama endpoint (local only — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Model selection (CPU-safe quantised models)
# Options: llama3.2:3b | mistral:7b-instruct-q4_0 | phi3:mini
OLLAMA_MODEL=llama3.2:3b

# Agent settings
MAX_TOOL_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=15
CODE_EXEC_TIMEOUT_SECONDS=15

# Memory
SESSION_MEMORY_DIR=./data/sessions
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_COLLECTION=analyst_memory
SHORT_TERM_MEMORY_SIZE=20

# Logging
LOG_LEVEL=INFO

# API server (used by api.py / uvicorn)
API_HOST=0.0.0.0
API_PORT=8000
